# PostgreSQL connection string. Keep this private.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fund?sslmode=require"

# Required for all agent-facing API requests. Generate a long random value.
# Send it as: Authorization: Bearer <token>
FUND_AGENT_TOKEN="replace-with-a-long-random-secret"

# Private single-owner dashboard sign-in.
# Use a long unique password and a separate random secret of at least 32 characters.
FUND_OWNER_PASSWORD="replace-with-a-long-unique-password"
FUND_SESSION_SECRET="replace-with-at-least-32-random-characters"
